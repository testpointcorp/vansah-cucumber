# =============================================================================
# Vansah Cucumber Integration - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Vansah API Token
# -----------------------------------------------------------------------------
# Get from: Jira Project → Vansah → Settings → Generate Token
VANSAH_TOKEN=your_vansah_token_here

# -----------------------------------------------------------------------------
# REQUIRED: Jira Project Key
# -----------------------------------------------------------------------------
VANSAH_PROJECT_KEY=SCRUM

# -----------------------------------------------------------------------------
# REQUIRED: Vansah API URL (Data Residency)
# -----------------------------------------------------------------------------
VANSAH_URL=https://prod.vansah.com

# -----------------------------------------------------------------------------
# CONTEXT ASSETS: At least ONE is required
# -----------------------------------------------------------------------------
# Priority order (highest to lowest):
# 1. advancedTestPlanKey
# 2. standardTestPlanKey
# 3. testFolderPath
# 4. jiraIssueKey

# Test Folder Path (format: FolderName or Folder/SubFolder)
TEST_FOLDER_PATH="Automation/Cucumber"

# OR Jira Issue Key (link test runs to a Jira issue)
# JIRA_ISSUE_KEY="SCRUM-1"

# OR Standard Test Plan Key
# STANDARD_TEST_PLAN_KEY="SCRUM-P2"

# OR Advanced Test Plan Key (requires testFolderPath or jiraIssueKey)
# ADVANCED_TEST_PLAN_KEY="SCRUM-P1"

# -----------------------------------------------------------------------------
# OPTIONAL: Test Run Properties
# -----------------------------------------------------------------------------
# Associate test runs with Sprint (auto-created if doesn't exist)
# SPRINT_NAME="Sprint 1"

# Associate test runs with Release (auto-created if doesn't exist)
# RELEASE_NAME="v1.0.0"

# Associate test runs with Environment (auto-created if doesn't exist)
# ENVIRONMENT_NAME="UAT"

# -----------------------------------------------------------------------------
# OPTIONAL: Form-Data Import Options (import_results.sh only)
# -----------------------------------------------------------------------------
# Enable step-level reporting (creates individual log entries for each step)
# STEP_LEVEL_REPORTING=true
