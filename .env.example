# ===========================================
# Vansah Configuration - REQUIRED
# ===========================================

# Vansah API Token (get from Vansah settings)
VANSAH_TOKEN=your-vansah-token-here

# Jira Project Key
VANSAH_PROJECT_KEY=PROJ

# ===========================================
# Integration Context (at least one required)
# ===========================================

# Option 1: Test Folder Path
TEST_FOLDER_PATH=Root/Automation

# Option 2: Link to Jira Issue
# JIRA_ISSUE_KEY=PROJ-123

# Option 3: Advanced Test Plan
# ADVANCED_TEST_PLAN_KEY=PROJ-P1

# Option 4: Standard Test Plan
# STANDARD_TEST_PLAN_KEY=PROJ-P2

# ===========================================
# Optional Settings
# ===========================================

# Enable step-level reporting (default: false = quick test mode)
# STEP_LEVEL_REPORTING=true

# Enable screenshot on failure (default: false)
# SCREENSHOT_ON_FAILURE=true

# Sprint name for test runs
# SPRINT_NAME=Sprint 1

# Release/version name
# RELEASE_NAME=v1.0.0

# Environment name
# ENVIRONMENT_NAME=UAT

# Custom Vansah URL (for data residency)
# VANSAH_URL=https://prod.vansah.com
